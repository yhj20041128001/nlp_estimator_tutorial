# ============================================================
# MySQL / TiDB 数据库账号安全监控配置
# ============================================================
# 使用说明:
#   1. 复制本文件并重命名为 .account_monitor.yml
#   2. 填写真实配置信息
#   3. .account_monitor.yml 不提交 git（已加入 .gitignore）

# 全局监控配置
monitor:
  # 轮询间隔(秒)，账号监控无需高频，建议 30~60 秒
  poll_interval: 30
  # 日志文件路径(相对于本文件所在目录)
  log_file: account_monitor.log
  # 状态文件路径(相对于本文件所在目录，自动生成，不需要手动创建)
  state_file: account_monitor_state.json
  # 高危账号列表(F2)：这些账号登录时立即告警
  high_risk_users:
    - dba_root
    - root
  # 休眠账号告警阈值(F3)，单位：天，并列触发（满足任一即告警）
  dormant_thresholds_days:
    - 1
    - 7
    - 30

# Telegram 告警推送配置
telegram:
  enabled: true
  token: "your-bot-token"
  # 所有告警统一发送到此 chat_id
  chat_id: "-100xxxxxxxxxx"

# 代理配置(按需启用)
proxy:
  enabled: false
  http: "http://xx.xx.xx.xx:xxxx"
  https: "http://xx.xx.xx.xx:xxxx"

# ============================================================
# 数据库节点列表
#
# 监控账号所需权限：
#   GRANT SELECT ON mysql.user TO 'monitor_user'@'%';
#   GRANT SELECT ON information_schema.* TO 'monitor_user'@'%';
#   GRANT PROCESS ON *.* TO 'monitor_user'@'%';
#
# dbType 填写说明：
#   mysql        - 标准 MySQL（主从 / MGR）
#   tidb         - TiDB 集群（协议兼容 MySQL，无需额外适配）
#
# 增减节点：复制粘贴一个条目，修改 host/port/password 即可
# ============================================================

# ============================================================
# 示例一: MySQL 主从
# ============================================================
# databases:
#   - note: "生产主库"
#     tenant: "xxx部门"
#     dbProject: "xxx项目"
#     dbType: "mysql 主从"
#     hostname: "master.sql.tencentcdb.com"
#     host: "10.0.0.1"
#     port: 3306
#     username: "dba_monitor_alert"
#     password: "your_password"
#
#   - note: "生产从库"
#     tenant: "xxx部门"
#     dbProject: "xxx项目"
#     dbType: "mysql 主从"
#     hostname: "slave1.sql.tencentcdb.com"
#     host: "10.0.0.2"
#     port: 3306
#     username: "dba_monitor_alert"
#     password: "your_password"

# ============================================================
# 示例二: MySQL MGR 集群
# ============================================================
# databases:
#   - note: "MGR-PRIMARY"
#     tenant: "xxx部门"
#     dbProject: "xxx项目"
#     dbType: "mysql mgr集群"
#     hostname: "mgr-primary.sql.tencentcdb.com"
#     host: "10.0.0.1"
#     port: 3306
#     username: "dba_monitor_alert"
#     password: "your_password"
#
#   - note: "MGR-SECONDARY-1"
#     tenant: "xxx部门"
#     dbProject: "xxx项目"
#     dbType: "mysql mgr集群"
#     hostname: "mgr-secondary1.sql.tencentcdb.com"
#     host: "10.0.0.2"
#     port: 3306
#     username: "dba_monitor_alert"
#     password: "your_password"

# ============================================================
# 示例三: TiDB 集群
# ============================================================
# databases:
#   - note: "TiDB生产集群"
#     tenant: "xxx部门"
#     dbProject: "xxx项目"
#     dbType: "tidb"
#     hostname: "tidb-lb.internal"
#     host: "10.0.1.10"
#     port: 4000
#     username: "dba_monitor_alert"
#     password: "your_password"

# ============================================================
# 当前实际使用的配置 (取消注释并修改为真实信息)
# ============================================================
databases:

  - note: "示例-MySQL主库"
    tenant: "运维部门"
    dbProject: "核心业务"
    dbType: "mysql 主从"
    hostname: "db-master-01.internal"
    host: "10.0.0.1"
    port: 3306
    username: "dba_monitor_alert"
    password: "your_password"
